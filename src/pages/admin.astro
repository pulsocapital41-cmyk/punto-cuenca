---
import { AI_NEWSROOM_SCRIPT } from '../utils/aiNewsroom';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Sala de Redacción | Punto Cuenca</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
    <style is:global>
      /* Ocultar widgets y badges innecesarios de Netlify */
      #nl-badge-frame,
      #nl-hud-frame,
      iframe[title="Powered by Netlify"],
      iframe[title="Netlify"],
      iframe[title*="Netlify"] {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        width: 0 !important;
        height: 0 !important;
        pointer-events: none !important;
      }
    </style>
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <script is:inline src="https://unpkg.com/decap-cms@^3.1.2/dist/decap-cms.js"></script>
    <script is:inline set:html={AI_NEWSROOM_SCRIPT} />
  </body>
</html>
