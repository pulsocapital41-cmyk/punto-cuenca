---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { optimizeImage } from '../utils/cloudinary';

const allNews = (await getCollection('noticias')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const leadStory = allNews.find((item) => item.data.featured) || allNews[0];
const remainingNews = allNews.filter((item) => item.id !== leadStory.id);

const secondaryStories = remainingNews.slice(0, 2);
const sideBriefs = remainingNews.slice(2, 5);
const gridStories = remainingNews;

const leadDate = leadStory.data.pubDate.toLocaleDateString('es-EC', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const leadCategorySlug = leadStory.data.category
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '');

const leadDisplayCategory = leadStory.data.category === 'Capital' ? 'Cuenca' : leadStory.data.category;
const leadHeroImage = optimizeImage(leadStory.data.image, 1200);
---

<BaseLayout>
  <!-- Cintillo de Última Hora -->
  <section class="breaking-ticker" aria-label="Destacados del día">
    <div class="container breaking-ticker__inner">
      <span class="breaking-ticker__tag">En Portada</span>
      <div class="breaking-ticker__items">
        {allNews.slice(0, 3).map((item) => (
          <a href={`/noticias/${item.id}`} class="breaking-ticker__link">
            <strong class="breaking-ticker__cat">{item.data.category === 'Capital' ? 'Cuenca' : item.data.category}:</strong> {item.data.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Portada Principal (Estilo Gran Diario) -->
  <section class="frontpage container">
    <div class="frontpage__grid">
      <!-- Columna Principal: Nota de Apertura -->
      <article class="lead-story">
        <a href={`/noticias/${leadStory.id}`} class="lead-story__media">
          <img
            src={leadHeroImage}
            alt={leadStory.data.title}
            class="lead-story__img"
            fetchpriority="high"
          />
          {leadStory.data.imageCaption && (
            <span class="lead-story__caption">{leadStory.data.imageCaption}</span>
          )}
        </a>

        <div class="lead-story__content">
          <div class="lead-story__meta">
            <a href={`/categoria/${leadCategorySlug}`} class="kicker">
              {leadDisplayCategory}
            </a>
            <span class="lead-story__read">{leadStory.data.readTime} de lectura</span>
          </div>

          <h1 class="lead-story__title">
            <a href={`/noticias/${leadStory.id}`}>{leadStory.data.title}</a>
          </h1>

          <p class="lead-story__subtitle">{leadStory.data.subtitle}</p>

          <div class="lead-story__byline">
            Por <strong>{leadStory.data.author}</strong> · <time datetime={leadStory.data.pubDate.toISOString()}>{leadDate}</time>
          </div>
        </div>
      </article>

      <!-- Columna Central: Sub-portada -->
      <div class="sub-stories">
        {secondaryStories.map((story) => (
          <NewsCard article={story} />
        ))}
      </div>

      <!-- Columna Derecha: El Pulso del Día / Opinión -->
      <aside class="pulse-sidebar">
        <div class="pulse-sidebar__header">
          <span class="pulse-sidebar__dot"></span>
          <h2 class="pulse-sidebar__title">El Punto del Día</h2>
        </div>

        <div class="pulse-sidebar__list">
          {sideBriefs.map((story, index) => (
            <div class="pulse-item">
              <span class="pulse-item__num">0{index + 1}</span>
              <div class="pulse-item__content">
                <span class="kicker kicker--blue">{story.data.category === 'Capital' ? 'Cuenca' : story.data.category}</span>
                <h3 class="pulse-item__title">
                  <a href={`/noticias/${story.id}`}>{story.data.title}</a>
                </h3>
                <span class="pulse-item__meta">{story.data.author} · {story.data.readTime}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="editorial-callout">
          <span class="kicker">Buzón Ciudadano</span>
          <h3 class="editorial-callout__title">¿Tienes un reporte ciudadano o denuncia en Cuenca?</h3>
          <p class="editorial-callout__text">
            Nuestro equipo de investigación verifica datos, obras barriales y documentos públicos con reserva de fuente.
          </p>
          <a href="mailto:denuncias@puntocuenca.net" class="editorial-callout__link">
            Enviar reporte a Redacción →
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Sección: Cobertura Especial & Radar del Austro -->
  <section class="container radar-section">
    <div class="section-header">
      <h2 class="section-header__title">Radar de Cuenca y el Azuay</h2>
      <a href="/categoria/capital" class="section-header__link">Ver cobertura completa →</a>
    </div>

    <div class="news-grid">
      {gridStories.map((story) => (
        <div class="news-grid__item">
          <NewsCard article={story} />
        </div>
      ))}
    </div>
  </section>

  <!-- Banda de Claves Económicas y Urbanas -->
  <section class="metrics-strip">
    <div class="container">
      <div class="metrics-strip__header">
        <span class="kicker">Indicadores de Cuenca</span>
        <h2 class="metrics-strip__title">Termómetro Urbano & Productivo del Azuay</h2>
      </div>
      <div class="metrics-strip__grid">
        <div class="metric-card">
          <span class="metric-card__label">Tranvía de Cuenca</span>
          <strong class="metric-card__value">+23 M</strong>
          <span class="metric-card__trend metric-card__trend--up">Viajes anuales en la ruta Río Tarqui – Parque Industrial</span>
        </div>
        <div class="metric-card">
          <span class="metric-card__label">Patrimonio UNESCO</span>
          <strong class="metric-card__value">224 ha</strong>
          <span class="metric-card__trend">Centro Histórico protegido y 4 ríos emblemáticos</span>
        </div>
        <div class="metric-card">
          <span class="metric-card__label">Industria y Exportación</span>
          <strong class="metric-card__value">#1 Austro</strong>
          <span class="metric-card__trend metric-card__trend--up">Liderazgo en cerámica, línea blanca, muebles y sombrero de paja toquilla</span>
        </div>
        <div class="metric-card">
          <span class="metric-card__label">Ecosistema Universitario</span>
          <strong class="metric-card__value">4 Grandes</strong>
          <span class="metric-card__trend">UCuenca, UDA, UPS y U. Católica impulsan I+D regional</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Breaking Ticker */
  .breaking-ticker {
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--color-rule-light);
    padding: 0.55rem 0;
  }

  .breaking-ticker__inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    overflow: hidden;
  }

  .breaking-ticker__tag {
    background-color: var(--color-brand-blue);
    color: #FFFFFF;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.22rem 0.55rem;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .breaking-ticker__items {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    font-size: 0.82rem;
  }

  .breaking-ticker__items::-webkit-scrollbar {
    display: none;
  }

  .breaking-ticker__link {
    color: var(--color-ink-secondary);
  }

  .breaking-ticker__link:hover {
    color: var(--color-brand-red);
  }

  .breaking-ticker__cat {
    color: var(--color-brand-red);
    font-weight: 700;
  }

  /* Frontpage Grid */
  .frontpage {
    padding-top: 2rem;
    padding-bottom: 1.5rem;
  }

  .frontpage__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Lead Story */
  .lead-story {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .lead-story__media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 5px;
    background: #E4E7EB;
  }

  .lead-story__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .lead-story:hover .lead-story__img {
    transform: scale(1.02);
  }

  .lead-story__caption {
    display: block;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    background: var(--color-surface);
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid var(--color-rule-light);
  }

  .lead-story__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  .lead-story__read {
    font-size: 0.76rem;
    color: var(--color-ink-muted);
    font-weight: 600;
  }

  .lead-story__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.55rem);
    font-weight: 800;
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }

  .lead-story__title a:hover {
    color: var(--color-brand-blue);
  }

  .lead-story__subtitle {
    font-family: var(--font-body);
    font-size: 1.08rem;
    line-height: 1.55;
    color: var(--color-ink-secondary);
    margin-bottom: 0.85rem;
  }

  .lead-story__byline {
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    padding-top: 0.65rem;
    border-top: 1px solid var(--color-rule-light);
  }

  /* Sub stories */
  .sub-stories {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Pulse Sidebar */
  .pulse-sidebar {
    background: var(--color-surface);
    border: 1px solid var(--color-rule-light);
    border-top: 4px solid var(--color-brand-red);
    border-radius: 4px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pulse-sidebar__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-rule-light);
  }

  .pulse-sidebar__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-brand-red);
  }

  .pulse-sidebar__title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-ink);
  }

  .pulse-sidebar__list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .pulse-item {
    display: flex;
    gap: 0.85rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--color-rule-light);
  }

  .pulse-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .pulse-item__num {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-brand-blue);
    opacity: 0.35;
    line-height: 1;
  }

  .pulse-item__content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pulse-item__title {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .pulse-item__title a:hover {
    color: var(--color-brand-red);
  }

  .pulse-item__meta {
    font-size: 0.73rem;
    color: var(--color-ink-muted);
  }

  .editorial-callout {
    margin-top: auto;
    background: var(--color-paper);
    border-left: 3px solid var(--color-brand-blue);
    padding: 1rem;
    border-radius: 3px;
  }

  .editorial-callout__title {
    font-family: var(--font-serif);
    font-size: 1rem;
    margin: 0.3rem 0 0.4rem;
  }

  .editorial-callout__text {
    font-size: 0.82rem;
    color: var(--color-ink-secondary);
    margin-bottom: 0.65rem;
  }

  .editorial-callout__link {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--color-brand-blue);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .editorial-callout__link:hover {
    color: var(--color-brand-red);
  }

  /* Radar Grid */
  .radar-section {
    padding-top: 2rem;
    padding-bottom: 2.5rem;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Metrics Strip */
  .metrics-strip {
    background: var(--color-surface);
    border-top: 1px solid var(--color-rule-medium);
    border-bottom: 1px solid var(--color-rule-medium);
    padding: 2.5rem 0;
    margin-top: 1rem;
  }

  .metrics-strip__header {
    margin-bottom: 1.35rem;
  }

  .metrics-strip__title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-top: 0.25rem;
  }

  .metrics-strip__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .metric-card {
    background: var(--color-paper);
    border: 1px solid var(--color-rule-light);
    border-left: 4px solid var(--color-brand-blue);
    padding: 1.1rem 1.25rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-card:nth-child(even) {
    border-left-color: var(--color-brand-red);
  }

  .metric-card__label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-muted);
  }

  .metric-card__value {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-ink);
  }

  .metric-card__trend {
    font-size: 0.78rem;
    color: var(--color-ink-secondary);
  }

  .metric-card__trend--up {
    color: #1B3B6F;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .metrics-strip__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .frontpage__grid {
      grid-template-columns: 1.65fr 1fr 0.95fr;
      align-items: start;
    }

    .lead-story {
      padding-right: 1.5rem;
      border-right: 1px solid var(--color-rule-light);
    }

    .sub-stories {
      padding-right: 1.5rem;
      border-right: 1px solid var(--color-rule-light);
    }

    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .metrics-strip__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
