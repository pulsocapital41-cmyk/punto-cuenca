---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { optimizeImage } from '../../utils/cloudinary';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allNews = (await getCollection('noticias'))
  .filter((item) => item.id !== article.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formattedDate = article.data.pubDate.toLocaleDateString('es-EC', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const categorySlug = article.data.category
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '');

const displayCategory = article.data.category === 'Capital' ? 'Cuenca' : article.data.category;

const articleUrl = new URL(Astro.url.pathname, Astro.site || 'https://puntocuenca.net').toString();
const encodedTitle = encodeURIComponent(article.data.title);
const encodedUrl = encodeURIComponent(articleUrl);
const heroImage = optimizeImage(article.data.image, 1200);
---

<BaseLayout
  title={article.data.title}
  description={article.data.subtitle}
  image={article.data.image}
  article={true}
  publishedTime={article.data.pubDate.toISOString()}
  author={article.data.author}
  category={displayCategory}
>
  <article class="article-page container">
    <header class="article-header">
      <div class="article-header__meta">
        <a href={`/categoria/${categorySlug}`} class="kicker">
          {displayCategory}
        </a>
        <span class="article-header__readtime">{article.data.readTime} de lectura</span>
      </div>

      <h1 class="article-header__title">{article.data.title}</h1>
      <p class="article-header__subtitle">{article.data.subtitle}</p>

      <div class="article-header__byline">
        <div>
          Por <strong>{article.data.author}</strong>
        </div>
        <time datetime={article.data.pubDate.toISOString()}>{formattedDate}</time>
      </div>

      <!-- Barra de Compartir en Redes -->
      <div class="share-bar">
        <span class="share-bar__label">Compartir nota:</span>
        <div class="share-bar__buttons">
          <a
            href={`https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn share-btn--wa"
            aria-label="Compartir en WhatsApp"
          >
            WhatsApp
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn share-btn--x"
            aria-label="Compartir en X"
          >
            X / Twitter
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn share-btn--fb"
            aria-label="Compartir en Facebook"
          >
            Facebook
          </a>
          <button
            type="button"
            class="share-btn share-btn--copy"
            id="copy-link-btn"
            data-url={articleUrl}
          >
            Copiar enlace
          </button>
        </div>
      </div>
    </header>

    <figure class="article-figure">
      <img
        src={heroImage}
        alt={article.data.title}
        class="article-figure__img"
        fetchpriority="high"
      />
      {article.data.imageCaption && (
        <figcaption class="article-figure__caption">
          {article.data.imageCaption}
        </figcaption>
      )}
    </figure>

    <div class="article-content">
      <Content />
    </div>
  </article>

  <section class="related-section container">
    <div class="section-header">
      <h2 class="section-header__title">Continúa leyendo en Punto Cuenca</h2>
      <a href="/" class="section-header__link">Volver a portada →</a>
    </div>
    <div class="related-grid">
      {allNews.map((item) => (
        <NewsCard article={item} />
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.getAttribute('data-url') || window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      const original = copyBtn.textContent;
      copyBtn.textContent = '¡Enlace copiado!';
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 2000);
    } catch {
      // Fallback
    }
  });
</script>

<style>
  .article-page {
    max-width: 880px;
    padding-top: 2.25rem;
    padding-bottom: 2.5rem;
  }

  .article-header {
    margin-bottom: 1.75rem;
  }

  .article-header__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .article-header__readtime {
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    font-weight: 600;
  }

  .article-header__title {
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 3.8vw, 2.85rem);
    font-weight: 800;
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }

  .article-header__subtitle {
    font-family: var(--font-body);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-ink-secondary);
    margin-bottom: 1.25rem;
  }

  .article-header__byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-rule-light);
    border-bottom: 1px solid var(--color-rule-light);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    text-transform: capitalize;
  }

  .article-header__byline strong {
    color: var(--color-ink);
  }

  /* Share Bar */
  .share-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.9rem;
  }

  .share-bar__label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
  }

  .share-bar__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.38rem 0.75rem;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    border: 1px solid var(--color-rule-medium);
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .share-btn--wa:hover {
    background: #128C7E;
    border-color: #128C7E;
    color: #fff;
  }

  .share-btn--x:hover {
    background: #0F1419;
    border-color: #0F1419;
    color: #fff;
  }

  .share-btn--fb:hover {
    background: #1877F2;
    border-color: #1877F2;
    color: #fff;
  }

  .share-btn--copy:hover {
    background: var(--color-brand-blue);
    border-color: var(--color-brand-blue);
    color: #fff;
  }

  .article-figure {
    margin-bottom: 2.25rem;
  }

  .article-figure__img {
    width: 100%;
    border-radius: 5px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-figure__caption {
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    margin-top: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule-light);
  }

  .article-content {
    font-family: var(--font-body);
    font-size: 1.14rem;
    line-height: 1.8;
    color: var(--color-ink);
  }

  .article-content :global(p) {
    margin-bottom: 1.4rem;
  }

  .article-content :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 800;
    margin: 2.2rem 0 0.85rem;
    color: var(--color-ink);
  }

  .article-content :global(blockquote) {
    margin: 1.8rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid var(--color-brand-red);
    background: var(--color-surface);
    font-style: italic;
    font-size: 1.18rem;
    color: var(--color-ink-secondary);
  }

  .related-section {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
