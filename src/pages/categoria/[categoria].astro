---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'capital', name: 'Capital', displayName: 'Cuenca', desc: 'Obras públicas, movilidad, Tranvía, Centro Histórico, barrios y gestión municipal en Cuenca.' },
    { slug: 'politica', name: 'Política', displayName: 'Política', desc: 'Concejo Cantonal, Prefectura del Azuay, Asamblea Nacional y decisiones públicas de la región.' },
    { slug: 'economia', name: 'Economía', displayName: 'Economía', desc: 'Industria cuencana, comercio, turismo, exportaciones, empleo y finanzas del Austro ecuatoriano.' },
    { slug: 'sociedad', name: 'Sociedad', displayName: 'Sociedad', desc: 'Cultura, universidades, patrimonio, medio ambiente, los cuatro ríos de Cuenca y vida comunitaria.' },
    { slug: 'opinion', name: 'Opinión', displayName: 'Opinión', desc: 'Columnas de análisis, editoriales y voces plurales sobre el futuro de Cuenca y el Ecuador.' },
  ];

  const allNews = await getCollection('noticias');

  return categories.map((cat) => {
    const filtered = allNews
      .filter((item) => item.data.category === cat.name)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { categoria: cat.slug },
      props: {
        categoryName: cat.displayName,
        categoryDescription: cat.desc,
        articles: filtered,
      },
    };
  });
}

const { categoryName, categoryDescription, articles } = Astro.props;
---

<BaseLayout
  title={`Sección ${categoryName} — Punto Cuenca`}
  description={categoryDescription}
>
  <section class="category-page container">
    <header class="category-banner">
      <span class="kicker">Cobertura Especializada</span>
      <h1 class="category-banner__title">{categoryName}</h1>
      <p class="category-banner__desc">{categoryDescription}</p>
    </header>

    {articles.length > 0 ? (
      <div class="category-grid">
        {articles.map((article) => (
          <NewsCard article={article} />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Pronto publicaremos nuevos reportajes en la sección de {categoryName}.</p>
        <a href="/" class="empty-state__link">Volver a la portada principal →</a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .category-page {
    padding-top: 2.25rem;
    padding-bottom: 3rem;
  }

  .category-banner {
    border-top: 4px solid var(--color-brand-blue);
    border-bottom: 1px solid var(--color-rule-medium);
    padding: 1.5rem 0;
    margin-bottom: 2.25rem;
  }

  .category-banner__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-ink);
    margin: 0.25rem 0 0.5rem;
  }

  .category-banner__desc {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-ink-secondary);
    max-width: 680px;
  }

  .category-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .empty-state {
    background: var(--color-surface);
    border: 1px solid var(--color-rule-light);
    padding: 3rem 2rem;
    text-align: center;
    border-radius: 4px;
  }

  .empty-state__link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
    color: var(--color-brand-blue);
  }

  @media (min-width: 768px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .category-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
