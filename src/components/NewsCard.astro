---
import type { CollectionEntry } from 'astro:content';
import { optimizeImage } from '../utils/cloudinary';

interface Props {
  article: CollectionEntry<'noticias'>;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const { title, subtitle, excerpt, category, author, pubDate, image, readTime } = article.data;
const summaryText = subtitle || excerpt || '';

const formattedDate = pubDate.toLocaleDateString('es-EC', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const categorySlug = category
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '');

const displayCategory = category === 'Capital' ? 'Cuenca' : category;
const optimizedImg = optimizeImage(image, featured ? 1000 : 720);
---

<article class:list={['grid-card', { 'grid-card--featured': featured }]}>
  <img
    src={optimizedImg}
    alt={title}
    loading={featured ? 'eager' : 'lazy'}
    class="grid-card__img"
  />

  <header class="grid-card__header">
    <div class="grid-card__badges">
      <a href={`/categoria/${categorySlug}`} class="kicker">
        {displayCategory}
      </a>
      <span class="grid-card__time">{readTime}</span>
    </div>

    <h2 class="grid-card__title">
      <a href={`/noticias/${article.id}`} class="card-link">{title}</a>
    </h2>
  </header>

  <p class="grid-card__summary">{summaryText}</p>

  <footer class="grid-card__footer">
    <span class="grid-card__author">{author}</span>
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
  </footer>
</article>

<style>
  .grid-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-rule-light);
    border-radius: 16px;
    overflow: clip;
    display: grid;
    grid-row: span 4;
    grid-template-rows: auto auto 1fr auto;
    grid-template-rows: subgrid;
    gap: 0;
    box-shadow: 0 2px 10px rgba(7, 35, 62, 0.04);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .grid-card:has(a.card-link:hover) {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -12px rgba(7, 35, 62, 0.14);
    border-color: rgba(201, 160, 82, 0.65);
  }

  .grid-card:has(a.card-link:focus-visible) {
    outline: 2px solid var(--color-brand-blue);
    outline-offset: 2px;
  }

  .grid-card a.card-link:focus-visible {
    outline: none;
  }

  .grid-card a.card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .grid-card a:not(.card-link) {
    position: relative;
    z-index: 1;
  }

  .grid-card__img {
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background-color: #E2E8F0;
    border-bottom: 1px solid var(--color-rule-light);
  }

  .grid-card__header {
    padding: 1.15rem 1.25rem 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .grid-card__badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .grid-card__time {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .grid-card__title {
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1.32;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  .grid-card:has(a.card-link:hover) .grid-card__title {
    color: var(--color-brand-blue);
  }

  .grid-card__summary {
    padding: 0 1.25rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    line-clamp: 3;
    overflow: clip;
    margin-block-end: 1rem;
  }

  .grid-card__footer {
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--color-rule-light);
    background: #FAFBFD;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .grid-card__author {
    font-weight: 700;
    color: var(--color-brand-blue);
  }
</style>
